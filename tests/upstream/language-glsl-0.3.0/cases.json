sion mediump int;\ninvariant gl_Position;\nout vec3 Color;\ninvariant Color;\ninvariant centroid out vec3 Color;\nvec4 color = vec4(0.0, 1.0, 0.0, 1.0);\nvoid main ()\n{\n}\nint i = 1 - 5 * 4 + 3;\nint i = 1 - (5 * 4) + 3;\nint i = (1 - 5) * 4 + 3;\nint i = (1 - 5) * (4 + 3);\nbool b = 1 < 2;\nvoid main ()\n{\n  if (intensity < 0.0) /* a comment */\n    return;\n\n  if (a & b)\n    return;\n\n  if (a | b)\n    return;\n\n  if (a && b)\n    return;\n\n  if (a || b)\n    return;\n}\n\nlayout (std140) uniform PatternBlock\n{ float pattern[100];\n  float arr[];\n};\n\nfloat x = a / b / c;\nfloat x = (a / b) / c;\nfloat x = a / (b / c);\n",
